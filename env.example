# Agno AI Agents Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Configuration
# Option 1: Use API Key (recommended for development)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Use Google Cloud CLI authentication (for production)
USE_GOOGLE_CLI_AUTH=false

# Google Cloud Configuration (if using CLI auth)
GCP_PROJECT_ID=your_project_id
GCP_LOCATION=us-central1

# Agent Configuration
AGENT_TEMPERATURE=0.2
AGENT_VERBOSE=true

# Web Scraping Configuration
SCRAPING_TIMEOUT=30
MAX_CONTENT_LENGTH=10000

# Model Configuration
DEFAULT_MODEL=gemini-1.5-flash
